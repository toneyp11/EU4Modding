# Normalize everything to LF (protects the required UTF-8 BOM on localisation .yml,
# keeps diffs stable, avoids CRLF churn on Windows). Binary is auto-detected & left.
* text=auto eol=lf

# Explicit for the Paradox script/data files and shell scripts (must stay LF).
*.gui  text eol=lf
*.gfx  text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.mod  text eol=lf
*.sh   text eol=lf
